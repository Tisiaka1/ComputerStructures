def parse_start_line(line):
    """
    Checks whether a source-code line contains START.
    Returns the program name and starting address.
    """

    source = line.rstrip("\n")

    # Remove comments beginning with a period
    code = source.split(".", 1)[0].strip()

    if not code:
        return None

    fields = code.split()
    upper_fields = [field.upper() for field in fields]

    if "START" not in upper_fields:
        return None

    start_index = upper_fields.index("START")

    # The program label normally appears before START
    if start_index > 0:
        program_name = fields[start_index - 1]
    else:
        program_name = "NONAME"

    # The operand after START is the starting hexadecimal address
    if start_index + 1 < len(fields):
        try:
            start_address = int(fields[start_index + 1], 16)
        except ValueError:
            raise ValueError(
                "The START operand must be a hexadecimal address."
            )
    else:
        start_address = 0

    return program_name, start_address


def run_first_pass(file_name="functions.txt"):
    """
    Reads the SIC/XE source program and begins Pass 1.

    Ranbir's section:
    - Read the input file
    - Recognize START
    - Save the program name
    - Save the starting address
    - Initialize LOCCTR
    """

    program_name = "NONAME"
    starting_address = 0
    location_counter = 0
    start_found = False

    intermediate_lines = []

    try:
        with open(file_name, "r", encoding="utf-8") as source_file:

            for line_number, line_content in enumerate(
                source_file,
                start=1
            ):
                clean_line = line_content.strip()

                # Ignore blank lines and full-line comments
                if not clean_line or clean_line.startswith("."):
                    continue

                start_data = parse_start_line(line_content)

                if start_data is not None:

                    if start_found:
                        raise ValueError(
                            "More than one START directive was found "
                            f"at line {line_number}."
                        )

                    program_name, starting_address = start_data

                    # Initialize the location counter
                    location_counter = starting_address
                    start_found = True

                    intermediate_lines.append(
                        {
                            "line_number": line_number,
                            "address": location_counter,
                            "source": line_content.rstrip("\n")
                        }
                    )

                    print(
                        f"START directive found on line {line_number}"
                    )
                    print(f"Program name: {program_name}")
                    print(
                        f"Starting address: "
                        f"{starting_address:04X}"
                    )
                    print(
                        f"LOCCTR initialized to: "
                        f"{location_counter:04X}"
                    )

                    continue

                # Taofeeq will add instruction-format and
                # location-counter processing here.

                # Berson will add label extraction,
                # SYMTAB processing, and error checking here.

                intermediate_lines.append(
                    {
                        "line_number": line_number,
                        "address": location_counter,
                        "source": line_content.rstrip("\n")
                    }
                )

    except FileNotFoundError:
        print(f"Error: {file_name} was not found.")
        return None

    if not start_found:
        print(
            "No START directive was found. "
            "The program starts at address 0000."
        )

    results = {
        "program_name": program_name,
        "starting_address": starting_address,
        "location_counter": location_counter,
        "intermediate_lines": intermediate_lines
    }

    return results


# Run Pass 1 using the functions.txt source program
result = run_first_pass("functions.txt")

# Display the main results
if result is not None:
    print()
    print("Pass 1 Information")
    print("------------------")
    print("Program name:", result["program_name"])
    print(
        "Starting address:",
        f'{result["starting_address"]:04X}'
    )
    print(
        "Current LOCCTR:",
        f'{result["location_counter"]:04X}'
    )
